FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    openssh-server \
    python3 \
    python3-pip \
    cron \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages mysql-connector-python

# Create monitor user + reports folder
RUN useradd -m -d /home/monitor -s /bin/bash monitor \
    && mkdir -p /home/monitor/reports \
    && mkdir -p /home/monitor/.ssh \
    && chown -R monitor:monitor /home/monitor

# SSH public key for key-based auth
COPY monitoring_key.pub /home/monitor/.ssh/authorized_keys
RUN chmod 700 /home/monitor/.ssh \
    && chmod 600 /home/monitor/.ssh/authorized_keys \
    && chown -R monitor:monitor /home/monitor/.ssh

# SSH server config
RUN mkdir /var/run/sshd \
    && sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i '/Subsystem.*sftp/d' /etc/ssh/sshd_config \
    && echo "Subsystem sftp internal-sftp" >> /etc/ssh/sshd_config

# Report generator script
COPY generate_reports.py /opt/generate_reports.py
RUN chmod +x /opt/generate_reports.py

# Cron job — run every 2 minutes
RUN echo "*/2 * * * * monitor /usr/bin/python3 /opt/generate_reports.py >> /var/log/reports.log 2>&1" > /etc/cron.d/reports \
    && chmod 0644 /etc/cron.d/reports \
    && touch /var/log/reports.log \
    && chown monitor:monitor /var/log/reports.log

COPY banking-sftp-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22

ENTRYPOINT ["/entrypoint.sh"]